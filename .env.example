# Optional: leave unset to run deterministic passive checks without AI.
SENTINEL_AI_API_KEY=
SENTINEL_AI_MODEL=
# Defaults to https://api.openai.com/v1; custom endpoints must use HTTPS (localhost HTTP is allowed).
SENTINEL_AI_BASE_URL=https://api.openai.com/v1

# Optional local data directory; defaults to artifacts/sentinel.
# SENTINEL_DATA_DIR=artifacts/sentinel

# Optional. If unset, Sentinel creates and persists a random session secret under SENTINEL_DATA_DIR.
# SENTINEL_SESSION_SECRET=

# Optional one-time owner bootstrap token. If unset, a random token is printed by the dashboard command.
# SENTINEL_BOOTSTRAP_TOKEN=
